{
  "name": "mcp-foundry",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "twenty:up": "docker compose -f docker-compose.twenty.yml up -d",
    "twenty:down": "docker compose -f docker-compose.twenty.yml down",
    "seed:twenty": "node --import tsx packages/adapter-twenty/bin/seed-twenty.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
