# 飞书企业自建应用凭据（开发者后台 → 应用 → 凭证与基础信息）。
# 复制为 .env 填入真实值——.env 已被仓库根 .gitignore 忽略，不会被提交。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 对话模型（OpenAI 兼容 /chat/completions；智谱 GLM / DeepSeek / vLLM 均可）
FOUNDRY_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FOUNDRY_LLM_API_KEY=
FOUNDRY_LLM_MODEL=glm-4.6

# 可选：CRM 数据走真实 Twenty REST（Bearer API key；缺省 fixture 内置演示数据）
# TWENTY_API_URL=http://127.0.0.1:3200
# TWENTY_API_KEY=

# 可选：审批卡片发到指定会话（如审批群的 chat_id）；不设则发到触发对话本身。
# 前提：飞书控制台把 card.action.trigger 回调订阅为「使用长连接接收」（无需公网 URL）
# FEISHU_APPROVAL_CHAT_ID=
