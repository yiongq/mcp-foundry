# 复制为 .env（同目录，已被 .gitignore 忽略）。

# —— 网关（对话身份）——
# 本地 fixture 网关：demo 头模式，起法见下方 README
FOUNDRY_MCP_URL=http://127.0.0.1:3100/mcp
FOUNDRY_MCP_USER=e007
FOUNDRY_MCP_ROLE=sales_rep
# 生产网关（token-jwks）：改用签名令牌，注释掉上面两行 demo 头
# FOUNDRY_MCP_URL=https://foundry.yiongspace.com/mcp
# FOUNDRY_MCP_TOKEN=<mint-token 签发的 ES256 令牌>

# —— 审批人（就地批复用）——
# 配了才能在本 UI 里点“同意/拒绝”；不配则 pending 仍显示，只是需去网关/飞书批。
# 审批权由网关按域校验（角色须标 approver），这里只带身份头。
FOUNDRY_MCP_APPROVER_USER=e005
FOUNDRY_MCP_APPROVER_ROLE=sales_manager
# 生产：FOUNDRY_MCP_APPROVER_TOKEN=<approver 角色的签名令牌>

# —— LLM（OpenAI 兼容 /chat/completions）——
# 缺 API_KEY 时服务仍起（可看页面、走审批），只是对话不可用。
# 共享密钥不必 copy：可把 FOUNDRY_LLM_* 放到【仓库根 .env】一处维护，本客户端启动时
# 会兜底读取（本目录 .env 与真实环境变量优先级更高）。见 app/__main__.py 的装载顺序。
FOUNDRY_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FOUNDRY_LLM_API_KEY=
FOUNDRY_LLM_MODEL=glm-4.6
